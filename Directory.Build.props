<Project>

  <!--
    Engine version, shared by every project of the solution. It follows Semantic Versioning
    (see docs/versioning.md) and must match the latest entry of CHANGELOG.md and the git tag (v1.1.0).
  -->
  <PropertyGroup>
    <Product>Gasci</Product>
    <Version>1.1.0</Version>
    <Authors>Grojman</Authors>
    <RepositoryUrl>https://github.com/Grojman/Gasci</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

</Project>
